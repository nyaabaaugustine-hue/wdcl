# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public address of the site once it is live (link previews, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://your-domain.org

# Form delivery (https://resend.com): every form on the site emails the library team
RESEND_API_KEY=
# The library's inbox that receives messages
CONTACT_TO_EMAIL=
# A sender address on a domain verified in Resend, e.g. Library website <no-reply@your-domain.org>
CONTACT_FROM_EMAIL=
